{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build firmware",
      "type": "process",
      "command": "cargo",
      "args": ["build", "--release"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Check firmware",
      "type": "process",
      "command": "cargo",
      "args": ["check"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Run Clippy",
      "type": "process",
      "command": "cargo",
      "args": ["clippy", "--", "-D", "warnings"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Check formatting",
      "type": "process",
      "command": "cargo",
      "args": ["fmt", "--all", "--", "--check"],
      "problemMatcher": []
    },
    {
      "label": "Flash and monitor",
      "type": "process",
      "command": "cargo",
      "args": ["run", "--release"],
      "problemMatcher": ["$rustc"]
    }
  ]
}
